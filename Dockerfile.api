# QuantMind API Service Dockerfile (PRD v4.0 Productization)
FROM python:3.10-slim

WORKDIR /app

# Install system utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy python project specs and install dependencies
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Copy source code and scripts
COPY src /app/src
COPY configs /app/configs
COPY scripts /app/scripts

# Default directory for persistent authoritative ledgers
ENV QUANTMIND_DATA_DIR=/app/data
ENV QUANTMIND_CORE_DB_PATH=/app/data/quantmind_core.db
ENV QUANTMIND_APP_DB_PATH=/app/data/quantmind_app.db
ENV PYTHONPATH=/app/src

RUN mkdir -p /app/data

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "quantmind.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
